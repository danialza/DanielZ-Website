---
import PageLayout from "@/layouts/Base.astro";
import ReadmeContent from "@/content/private-pages/talkingheadai-readme.md";

const repositoryUrl = "https://github.com/danialza/TalkingHeadAI";
const videoPoster = "/videos/talking-head-ai/talking-head-ai-poster.jpg";
const videoSrc = "/videos/talking-head-ai/talking-head-ai-demo.mp4";
const folderStructureEntries = [
	{ name: "ai-services", type: "folder" },
	{ name: "assets/diagrams", type: "folder" },
	{ name: "backend", type: "folder" },
	{ name: "demo/university", type: "folder" },
	{ name: "frontend", type: "folder" },
	{ name: "nginx", type: "folder" },
	{ name: "scripts", type: "folder" },
	{ name: ".env.example", type: "file" },
	{ name: ".gitignore", type: "file" },
	{ name: "IMPLEMENTATION_PLAN.md", type: "file" },
	{ name: "Makefile", type: "file" },
	{ name: "README.md", type: "file" },
	{ name: "docker-compose.override.yml", type: "file" },
	{ name: "docker-compose.yml", type: "file" },
	{ name: "podcast_qa_seed.json", type: "file" },
	{ name: "run.sh", type: "file" },
	{ name: "setup.sh", type: "file" },
] as const;
---

<PageLayout
	meta={{
		title: "TalkingHeadAI",
		description: "Private link-only page for TalkingHeadAI demo, README, and folder structure.",
		robots: "noindex, nofollow, noarchive",
	}}
>
	<section class="space-y-8">
		<header class="space-y-3">
			<h1 class="title">TalkingHeadAI</h1>
			<p class="leading-relaxed">
				This page is shared only by direct link. Video comes first, then README, followed by the
				repository folder structure.
			</p>
			<p>
				Repository:
				<a class="underline decoration-dotted underline-offset-4" href={repositoryUrl} rel="noreferrer noopener" target="_blank">
					TalkingHeadAI
				</a>
			</p>
		</header>

		<section class="overflow-hidden rounded-xl border border-black/10 bg-black/5 shadow-sm dark:border-white/10 dark:bg-white/5">
			<video
				class="aspect-video w-full bg-black"
				controls
				playsinline
				poster={videoPoster}
				preload="none"
			>
				<source src={videoSrc} type="video/mp4" />
				Your browser does not support the video tag.
			</video>
		</section>

		<section class="rounded-xl border border-black/10 bg-black/5 p-4 shadow-sm dark:border-white/10 dark:bg-white/5 sm:p-6">
			<div class="mb-4">
				<h2 class="title mb-2 text-xl">README.md</h2>
				<p class="text-sm">
					Source:
					<a
						class="underline decoration-dotted underline-offset-4"
						href={`${repositoryUrl}/blob/main/README.md`}
						rel="noreferrer noopener"
						target="_blank"
					>
						GitHub README
					</a>
				</p>
			</div>

			<div class="prose dark:prose-invert max-w-none rounded-lg border border-black/10 bg-global-bg p-4 dark:border-white/10">
				<ReadmeContent />
			</div>
		</section>

		<section class="rounded-xl border border-black/10 bg-black/5 p-4 shadow-sm dark:border-white/10 dark:bg-white/5 sm:p-6">
			<div class="mb-4">
				<h2 class="title mb-2 text-xl">Repository Folder Structure</h2>
				<p class="text-sm">Styled snapshot of your root project layout.</p>
			</div>

			<div class="overflow-hidden rounded-lg border border-black/10 bg-global-bg dark:border-white/10">
				<ul class="divide-y divide-black/10 dark:divide-white/10">
					{
						folderStructureEntries.map((entry) => (
							<li class="flex items-center gap-3 px-3 py-2.5 font-mono text-sm">
								{
									entry.type === "folder" ? (
										<svg
											aria-hidden="true"
											class="h-5 w-5 shrink-0 text-sky-500"
											fill="none"
											stroke="currentColor"
											stroke-width="1.7"
											viewBox="0 0 24 24"
										>
											<path
												d="M3 7.5A1.5 1.5 0 0 1 4.5 6h4l1.7 1.7a1.5 1.5 0 0 0 1.1.4h8.2A1.5 1.5 0 0 1 21 9.6V18a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 18V7.5Z"
												stroke-linecap="round"
												stroke-linejoin="round"
											/>
										</svg>
									) : (
										<svg
											aria-hidden="true"
											class="h-5 w-5 shrink-0 text-zinc-500"
											fill="none"
											stroke="currentColor"
											stroke-width="1.7"
											viewBox="0 0 24 24"
										>
											<path
												d="M7.5 3.75h6l4.5 4.5v11.25A1.5 1.5 0 0 1 16.5 21h-9A1.5 1.5 0 0 1 6 19.5v-14A1.75 1.75 0 0 1 7.5 3.75Z"
												stroke-linecap="round"
												stroke-linejoin="round"
											/>
											<path d="M13.5 3.75v4.5H18" stroke-linecap="round" stroke-linejoin="round" />
										</svg>
									)
								}
								<span>{entry.name}</span>
								<span class="ms-auto text-xs text-zinc-500 dark:text-zinc-400">
									{entry.type === "folder" ? "Folder" : "File"}
								</span>
							</li>
						))
					}
				</ul>
			</div>
		</section>
	</section>
</PageLayout>
