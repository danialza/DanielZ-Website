{
	"installCommand": "pnpm install --no-frozen-lockfile",
	"buildCommand": "pnpm build",
	"redirects": [
		{
			"source": "/TalkingHeadAI-LiveDemo/",
			"destination": "https://audience-views-disposition-vehicle.trycloudflare.com",
			"permanent": false
		},
		{
			"source": "/TalkingHeadAI-LiveDemo",
			"destination": "https://audience-views-disposition-vehicle.trycloudflare.com",
			"permanent": false
		},
		{
			"source": "/blog/",
			"destination": "/posts/",
			"permanent": true
		},
		{
			"source": "/blog",
			"destination": "/posts/",
			"permanent": true
		},
		{
			"source": "/cv/",
			"destination": "/about-me/",
			"permanent": true
		},
		{
			"source": "/cv",
			"destination": "/about-me/",
			"permanent": true
		},
		{
			"source": "/index.htm",
			"destination": "/",
			"permanent": true
		},
		{
			"source": "/index.html",
			"destination": "/",
			"permanent": true
		},
		{
			"source": "/:path*",
			"has": [
				{
					"type": "host",
					"value": "www.danielz.co.uk"
				}
			],
			"destination": "https://danielz.co.uk/:path*",
			"permanent": true
		}
	]
}
