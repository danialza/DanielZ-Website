{
	"installCommand": "pnpm install --no-frozen-lockfile",
	"buildCommand": "pnpm build",
	"redirects": [
		{
			"source": "/TalkingHeadAI-LiveDemo/",
			"destination": "https://syndicate-implementing-interested-lessons.trycloudflare.com",
			"permanent": false
		},
		{
			"source": "/TalkingHeadAI-LiveDemo",
			"destination": "https://syndicate-implementing-interested-lessons.trycloudflare.com",
			"permanent": false
		},
		{
			"source": "/blog/",
			"destination": "/posts/",
			"permanent": true
		},
		{
			"source": "/blog",
			"destination": "/posts/",
			"permanent": true
		},
		{
			"source": "/cv/",
			"destination": "/about-me/",
			"permanent": true
		},
		{
			"source": "/cv",
			"destination": "/about-me/",
			"permanent": true
		},
		{
			"source": "/index.htm",
			"destination": "/",
			"permanent": true
		},
		{
			"source": "/index.html",
			"destination": "/",
			"permanent": true
		},
		{
			"source": "/downloads/research-associate-learning-based-robotic-carving-presentation.pptx",
			"destination": "https://github.com/danialza/DanielZ-Website/releases/download/research-carving-presentation-2026-08-05/research-associate-learning-based-robotic-carving-presentation.pptx",
			"permanent": true
		},
		{
			"source": "/notes",
			"destination": "/",
			"permanent": false
		},
		{
			"source": "/notes/:path*",
			"destination": "/",
			"permanent": false
		},
		{
			"source": "/:path*",
			"has": [
				{
					"type": "host",
					"value": "www.danielz.co.uk"
				}
			],
			"destination": "https://danielz.co.uk/:path*",
			"permanent": true
		}
	]
}
